{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/ping.schema.json",
  "title": "PING",
  "description": "Latido de la conexión. (ambos)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "PING"
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    }
  }
}
