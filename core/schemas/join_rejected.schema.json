{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/join_rejected.schema.json",
  "title": "JOIN_REJECTED",
  "description": "La unión fue rechazada. (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "seat",
    "reason"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "JOIN_REJECTED"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "seat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "reason": {
      "enum": [
        "TOKEN_INVALID",
        "TOKEN_USED",
        "SEAT_TAKEN",
        "BAD_SIGNATURE",
        "REJECTED"
      ]
    }
  }
}
