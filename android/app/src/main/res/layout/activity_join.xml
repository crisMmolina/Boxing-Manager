<?xml version="1.0" encoding="utf-8"?>
<!-- Unirse (DESIGN.md v4 §6.2): escanear el QR del lugar o escribir el código; nombre del juez y "Unirme". -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/join_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/view_top_bar" />

        <TextView
            style="@style/Text.Sigebox.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/join_title" />

        <TextView
            style="@style/Text.Sigebox.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/join_subtitle" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <!-- Escanear QR es la acción principal (spec 004); el QR llena la IP y el código. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/join_scan"
                    style="@style/Widget.Sigebox.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/join_scan"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart"
                    app:iconTint="@color/on_primary" />

                <TextView
                    style="@style/Text.Sigebox.Support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/join_or_code" />

                <TextView
                    style="@style/Text.Sigebox.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/join_name"
                    android:text="@string/join_name_label" />

                <FrameLayout
                    style="@style/Widget.Sigebox.FieldFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/join_name"
                            style="@style/Widget.Sigebox.FieldEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="80" />
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>

                <TextView
                    style="@style/Text.Sigebox.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/join_code"
                    android:text="@string/join_code_label" />

                <FrameLayout
                    style="@style/Widget.Sigebox.FieldFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:placeholderTextAppearance="@style/Text.Sigebox.FieldCode"
                        app:placeholderText="@string/join_code_example">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/join_code"
                            style="@style/Widget.Sigebox.FieldEdit.Code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>

                <TextView
                    style="@style/Text.Sigebox.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/join_host"
                    android:text="@string/join_host_label" />

                <FrameLayout
                    style="@style/Widget.Sigebox.FieldFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/join_host_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:placeholderText="@string/join_host_example"
                        app:startIconDrawable="@drawable/ic_wifi"
                        app:startIconTint="@color/ink_2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/join_host"
                            style="@style/Widget.Sigebox.FieldEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.:abcdefABCDEF[]"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>

                <!-- Solo con un QR de la forma anterior (pelea y lugar ya vienen en él). -->
                <TextView
                    android:id="@+id/join_seat"
                    style="@style/Text.Sigebox.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/join_error"
            style="@style/Text.Sigebox.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill"
            android:padding="12dp"
            android:visibility="gone" />

        <TextView
            style="@style/Text.Sigebox.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/join_wifi_note" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_submit"
            style="@style/Widget.Sigebox.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/join_submit" />
    </LinearLayout>
</ScrollView>
