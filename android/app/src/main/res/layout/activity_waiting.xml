<?xml version="1.0" encoding="utf-8"?>
<!-- Esperando aprobación (DESIGN.md v2 §6.3): la huella corta en grande para compararla con la central.
     v5 (AND-024): barra con chip de conexión y estado ilustrado con la insignia del reloj. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <include layout="@layout/view_top_bar" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/waiting_badge"
                style="@style/Widget.Sigebox.Badge"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/waiting_badge_icon"
                    style="@style/Widget.Sigebox.Badge.Icon"
                    android:src="@drawable/ic_clock"
                    android:tag="clock"
                    app:tint="@color/pending_ink" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/waiting_status"
                style="@style/Text.Sigebox.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/status_waiting_approval" />

            <TextView
                android:id="@+id/waiting_seat"
                style="@style/Text.Sigebox.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <!-- v6 (AND-030): la pelea a la que entra el juez, con las esquinas del código. -->
            <include layout="@layout/view_fight_card" />

            <TextView
                android:id="@+id/fight_names"
                style="@style/Text.Sigebox.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Sigebox.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/waiting_fingerprint_label" />

            <TextView
                android:id="@+id/waiting_fingerprint"
                style="@style/Text.Sigebox.Number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="@dimen/fingerprint" />

            <TextView
                android:id="@+id/waiting_body"
                style="@style/Text.Sigebox.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/waiting_body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/waiting_cancel"
        style="@style/Widget.Sigebox.Pill.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/waiting_cancel" />
</LinearLayout>
