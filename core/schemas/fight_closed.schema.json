{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/fight_closed.schema.json",
  "title": "FIGHT_CLOSED",
  "description": "El organizador cerró la pelea. (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "FIGHT_CLOSED"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
