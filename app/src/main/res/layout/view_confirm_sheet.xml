<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja de confirmación (DESIGN.md v2 §5.6): el resultado del round en grande, Enviar y Revisar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/confirm_title"
        style="@style/Text.Sigebox.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/confirm_red"
            style="@style/Text.Sigebox.Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/red_numeral"
            android:textSize="88sp" />

        <TextView
            style="@style/Text.Sigebox.Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="–"
            android:textColor="@color/ink_secondary"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/confirm_blue"
            style="@style/Text.Sigebox.Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue_numeral"
            android:textSize="88sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/confirm_round"
        style="@style/Text.Sigebox.Support"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_send" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_review"
        style="@style/Widget.Sigebox.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/confirm_review" />
</LinearLayout>
