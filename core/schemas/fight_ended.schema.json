{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/fight_ended.schema.json",
  "title": "FIGHT_ENDED",
  "description": "La pelea terminó (último round o terminación); cada juez envía su tarjeta final. (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "FIGHT_ENDED"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "reason": {
      "enum": [
        "KO",
        "KOT",
        "MEDICO",
        "ABANDONO",
        "DESCALIFICACION",
        "DECISION_TECNICA",
        "SIN_DECISION",
        "OTRO"
      ]
    }
  }
}
