<?xml version="1.0" encoding="utf-8"?>
<!-- v6 «Esquina» (spec 007): fila de esquina sobre arena, como las filas "valor · etiqueta · − +" de las apps de
     entrenamiento. Número grande a la izquierda con la etiqueta debajo, − y + circulares de 56 dp a la derecha.
     Mismos ids que view_corner_card: CornerScore y CornerCard la manejan igual; el tag "arena" les pide los colores
     de arena. La barrita de color junto a la píldora es corner_stripe (CornerScore le pone el color). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/arena_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:tag="arena">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/corner_value"
            style="@style/Text.Sigebox.Number.Arena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/corner_stripe"
                android:layout_width="6dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/corner_label"
                style="@style/Text.Sigebox.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/corner_name"
                style="@style/Text.Sigebox.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:textColor="@color/on_arena_2" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/corner_minus"
        style="@style/Widget.Sigebox.Button.Round.Arena"
        android:layout_width="@dimen/corner_row_button"
        android:layout_height="@dimen/corner_row_button"
        android:layout_marginEnd="12dp"
        app:icon="@drawable/ic_minus" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/corner_plus"
        style="@style/Widget.Sigebox.Button.Round.Arena"
        android:layout_width="@dimen/corner_row_button"
        android:layout_height="@dimen/corner_row_button"
        app:icon="@drawable/ic_plus" />
</LinearLayout>
