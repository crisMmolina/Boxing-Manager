<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de pelea (AND-030, spec 007 v6 «Esquina»): las dos esquinas en sus píldoras, juntas y centradas, con los rounds en un chip entre ellas.
     El nombre de cada boxeador va debajo, en la línea de nombres de cada pantalla. Oculta hasta conocer la pelea. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fight_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
        android:id="@+id/fight_red_pill"
        style="@style/Text.Sigebox.Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_red"
        android:layout_marginEnd="8dp"
        android:text="@string/corner_red"
        android:textColor="@color/on_red" />

    <TextView
        android:id="@+id/fight_rounds"
        style="@style/Text.Sigebox.Pill"
        android:layout_marginEnd="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill"
        android:textColor="@color/ink"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fight_blue_pill"
        style="@style/Text.Sigebox.Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_blue"
        android:text="@string/corner_blue"
        android:textColor="@color/on_blue" />
</LinearLayout>
