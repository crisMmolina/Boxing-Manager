<?xml version="1.0" encoding="utf-8"?>
<!-- Round tardío obligatorio (DESIGN.md v2 §6.5): las mismas tarjetas de esquina; no se puede salir sin enviar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/late_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/view_top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/late_title"
                style="@style/Text.Sigebox.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/late_status"
                style="@style/Text.Sigebox.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- v5 §5.16: segmentos de rounds; el actual es el round tardío. -->
        <LinearLayout
            android:id="@+id/late_progress"
            style="@style/Widget.Sigebox.RoundSegments" />

        <TextView
            style="@style/Text.Sigebox.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/late_body" />

        <include
            android:id="@+id/late_red_card"
            layout="@layout/view_corner_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <include
            android:id="@+id/late_blue_card"
            layout="@layout/view_corner_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/late_message"
            style="@style/Text.Sigebox.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/late_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/late_send" />
    </LinearLayout>
</ScrollView>
