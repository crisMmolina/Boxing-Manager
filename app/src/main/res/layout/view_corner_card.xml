<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de esquina (DESIGN.md v2 §5.3): píldora de la esquina, −, número grande, + y medidor. Sin totales. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/corner_label"
            style="@style/Text.Sigebox.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/corner_minus"
                style="@style/Widget.Sigebox.Button.Round"
                android:layout_width="@dimen/round_button"
                android:layout_height="@dimen/round_button"
                app:icon="@drawable/ic_minus" />

            <TextView
                android:id="@+id/corner_value"
                style="@style/Text.Sigebox.Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/corner_plus"
                style="@style/Widget.Sigebox.Button.Round"
                android:layout_width="@dimen/round_button"
                android:layout_height="@dimen/round_button"
                app:icon="@drawable/ic_plus"
                app:iconTint="#FFFFFF"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/corner_meter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="no"
            android:max="10"
            app:trackColor="@color/track"
            app:trackCornerRadius="4dp"
            app:trackThickness="@dimen/meter" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
