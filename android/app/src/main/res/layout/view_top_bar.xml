<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior: marca a la izquierda; "Juez N" y el chip de conexión a la derecha (DESIGN.md v5 §5.17 y §6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin_neg"
    android:layout_marginTop="@dimen/screen_margin_neg"
    android:layout_marginEnd="@dimen/screen_margin_neg"
    android:layout_marginBottom="@dimen/gap"
    android:background="@drawable/bar_background"
    android:gravity="center_vertical"
    android:minHeight="@dimen/bar_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="4dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/gap_small"
        android:importantForAccessibility="no"
        android:src="@drawable/logo" />

    <!-- v6: la marca nunca se recorta; lo que cede espacio es "Juez N". -->
    <com.sigebox.juez.ui.BrandText
        android:id="@+id/top_brand"
        style="@style/Text.Sigebox.Brand.Bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/app_name" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <!-- "Juez N" en la barra; se oculta cuando el texto solo repetiría el estado del chip. -->
    <TextView
        android:id="@+id/top_judge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:layout_marginStart="@dimen/gap_small"
        android:layout_marginEnd="@dimen/gap_small"
        android:fontFamily="@font/inter_semibold"
        android:maxLines="1"
        android:textColor="@color/on_bar_2"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- v5 §5.17: chip de conexión. Conectado = punto que late sobre success_soft; Sin conexión = anillo sobre surface_2. -->
    <com.sigebox.juez.ui.ConnectionChip
        android:id="@+id/top_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/top_dot"
            android:layout_width="@dimen/chip_dot"
            android:layout_height="@dimen/chip_dot"
            android:background="@drawable/dot_disconnected" />

        <TextView
            android:id="@+id/top_pill_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </com.sigebox.juez.ui.ConnectionChip>
</LinearLayout>
