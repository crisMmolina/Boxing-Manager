{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/state.schema.json",
  "title": "STATE",
  "description": "Estado de la pelea filtrado para un juez: solo sus propias tarjetas, nunca totales ni ganador. (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "seat",
    "judgeName",
    "redCorner",
    "blueCorner",
    "rounds",
    "fightStatus",
    "currentRound",
    "cards",
    "finalCardSent"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "STATE"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "seat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "judgeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "redCorner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "blueCorner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "fightStatus": {
      "enum": [
        "CREADA",
        "EN_CURSO",
        "TERMINADA",
        "CERRADA"
      ]
    },
    "currentRound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "roundStatus": {
      "enum": [
        "PENDIENTE",
        "ABIERTO",
        "CERRADO"
      ]
    },
    "cards": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "red",
          "blue",
          "status"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "red": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "blue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "status": {
            "enum": [
              "ENVIADA",
              "TARDIA",
              "CAPTURADA",
              "CORREGIDA"
            ]
          }
        }
      }
    },
    "finalCardSent": {
      "type": "boolean"
    }
  }
}
