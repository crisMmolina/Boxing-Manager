{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/submit_round.schema.json",
  "title": "SUBMIT_ROUND",
  "description": "Calificación de un round. Reenviar con el round abierto es una corrección; la central decide si es tardía. (juez → central)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "seat",
    "round",
    "red",
    "blue"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "SUBMIT_ROUND"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "red": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "blue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  }
}
