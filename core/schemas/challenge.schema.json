{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/challenge.schema.json",
  "title": "CHALLENGE",
  "description": "Primer mensaje de la central en cada conexión: el teléfono firma nonce en su JOIN o HELLO. Un nonce sirve una sola vez. (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "nonce"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "CHALLENGE"
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    }
  }
}
