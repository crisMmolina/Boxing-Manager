{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/round_opened.schema.json",
  "title": "ROUND_OPENED",
  "description": "El organizador abrió un round. (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "round"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "ROUND_OPENED"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  }
}
