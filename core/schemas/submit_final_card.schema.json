{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/submit_final_card.schema.json",
  "title": "SUBMIT_FINAL_CARD",
  "description": "Tarjeta final del juez: hash sale de FinalCardHash y sig firma DeviceProof.finalCardText. (juez → central)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "seat",
    "hash",
    "sig"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "SUBMIT_FINAL_CARD"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
    },
    "seat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sig": {
      "type": "string",
      "minLength": 40,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
