<?xml version="1.0" encoding="utf-8"?>
<!-- Escanear (DESIGN.md v2 §6.2): visor de cámara en una tarjeta de cristal con cuatro esquinas azul marino. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <include layout="@layout/view_top_bar_brand" />

    <TextView
        style="@style/Text.Sigebox.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/join_title" />

    <TextView
        style="@style/Text.Sigebox.Support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/scan_hint" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        app:contentPadding="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/scan_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/scan_frame" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
