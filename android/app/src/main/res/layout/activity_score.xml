<?xml version="1.0" encoding="utf-8"?>
<!-- Puntuar (DESIGN.md v4 §6.4): número grande con − y + por esquina. Nunca totales ni ganador. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/score_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/view_top_bar" />

        <!-- §5.6: la forma de la pantalla mientras llega el primer STATE. -->
        <com.sigebox.juez.ui.StateSkeleton
            android:id="@+id/score_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="@string/skeleton_loading"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:weightSum="100">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/skeleton_line"
                    android:layout_weight="60"
                    android:background="@drawable/skeleton_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <View style="@style/Widget.Sigebox.SkeletonDot" />

                <View style="@style/Widget.Sigebox.SkeletonDot" />

                <View style="@style/Widget.Sigebox.SkeletonDot" />
            </LinearLayout>

            <View
                android:id="@+id/skeleton_card_red"
                style="@style/Widget.Sigebox.SkeletonCard" />

            <View
                android:id="@+id/skeleton_card_blue"
                style="@style/Widget.Sigebox.SkeletonCard" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/skeleton_line"
                android:layout_marginTop="16dp"
                android:background="@drawable/skeleton_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="100">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/skeleton_line"
                    android:layout_weight="80"
                    android:background="@drawable/skeleton_line" />
            </LinearLayout>

            <TextView
                android:id="@+id/skeleton_slow"
                style="@style/Text.Sigebox.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/skeleton_slow"
                android:visibility="gone" />
        </com.sigebox.juez.ui.StateSkeleton>

        <LinearLayout
            android:id="@+id/score_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/score_round"
                    style="@style/Text.Sigebox.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- "Enviando…" con LoadingIndicator de Material 3 Expressive (DESIGN v3 §5). -->
                <com.google.android.material.loadingindicator.LoadingIndicator
                    android:id="@+id/score_sending"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    app:indicatorColor="@color/ink_2" />

                <TextView
                    android:id="@+id/score_status"
                    style="@style/Text.Sigebox.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- v5 §5.16: un segmento por round (cerrado, actual, futuro). -->
            <LinearLayout
                android:id="@+id/score_progress"
                style="@style/Widget.Sigebox.RoundSegments" />

            <!-- v5 §6, Round enviado: aparece tras el ACK en lugar de las tarjetas de puntuar. Solo la tarjeta
                 propia, sin totales ni ganador (principio 3). -->
            <LinearLayout
                android:id="@+id/score_sent_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <com.sigebox.juez.score.SentCheck
                    android:id="@+id/score_sent_check"
                    style="@style/Widget.Sigebox.SentCheck" />

                <TextView
                    android:id="@+id/score_sent_title"
                    style="@style/Text.Sigebox.SentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/score_sent_support"
                    style="@style/Text.Sigebox.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/ink_2" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/score_sent_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Sigebox.SentLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sent_card_label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/score_sent_red_label"
                                style="@style/Text.Sigebox.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/pill_red"
                                android:text="@string/corner_red"
                                android:textColor="@color/on_red" />

                            <TextView
                                android:id="@+id/score_sent_red"
                                style="@style/Text.Sigebox.SentNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:textColor="@color/red_numeral" />

                            <TextView
                                android:id="@+id/score_sent_blue"
                                style="@style/Text.Sigebox.SentNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/blue_numeral" />

                            <TextView
                                android:id="@+id/score_sent_blue_label"
                                style="@style/Text.Sigebox.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/pill_blue"
                                android:text="@string/corner_blue"
                                android:textColor="@color/on_blue" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <include
                android:id="@+id/score_red_card"
                layout="@layout/view_corner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <include
                android:id="@+id/score_blue_card"
                layout="@layout/view_corner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/score_message"
                style="@style/Text.Sigebox.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/score_correct"
                style="@style/Widget.Sigebox.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/sent_correct"
                app:icon="@drawable/ic_rotate_ccw"
                app:iconGravity="textStart"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/score_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/score_send" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
