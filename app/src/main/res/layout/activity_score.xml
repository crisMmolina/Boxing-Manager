<?xml version="1.0" encoding="utf-8"?>
<!-- Puntuar (DESIGN.md v2 §6.4): número grande con − y + por esquina. Nunca totales ni ganador. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/score_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/view_top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/score_round"
                style="@style/Text.Sigebox.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- "Enviando…" con LoadingIndicator de Material 3 Expressive (DESIGN v3 §5). -->
            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/score_sending"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:indicatorColor="@color/ink_2" />

            <TextView
                android:id="@+id/score_status"
                style="@style/Text.Sigebox.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/score_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <include
            android:id="@+id/score_red_card"
            layout="@layout/view_corner_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <include
            android:id="@+id/score_blue_card"
            layout="@layout/view_corner_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/score_message"
            style="@style/Text.Sigebox.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/score_correct"
            style="@style/Widget.Sigebox.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/score_correct"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/score_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/score_send" />
    </LinearLayout>
</ScrollView>
