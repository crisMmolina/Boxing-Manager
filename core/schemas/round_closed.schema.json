{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/round_closed.schema.json",
  "title": "ROUND_CLOSED",
  "description": "El organizador cerró un round. Con mustSubmit el teléfono vibra y exige calificar (envío tardío). (central → juez)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "round",
    "forced",
    "mustSubmit"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "ROUND_CLOSED"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "forced": {
      "type": "boolean"
    },
    "mustSubmit": {
      "type": "boolean"
    }
  }
}
