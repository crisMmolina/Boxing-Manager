<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior: marca a la izquierda y píldora con el punto de conexión a la derecha (DESIGN.md v2 §6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin_neg"
    android:layout_marginTop="@dimen/screen_margin_neg"
    android:layout_marginEnd="@dimen/screen_margin_neg"
    android:layout_marginBottom="@dimen/gap"
    android:background="@drawable/bar_background"
    android:gravity="center_vertical"
    android:minHeight="@dimen/bar_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="4dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/gap_small"
        android:importantForAccessibility="no"
        android:src="@drawable/logo" />

    <TextView
        style="@style/Text.Sigebox.Brand.Bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
                android:layout_weight="1"
        android:text="@string/app_name" />

    <LinearLayout
        android:id="@+id/top_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/top_dot"
            android:layout_width="@dimen/dot"
            android:layout_height="@dimen/dot"
            android:background="@drawable/dot_disconnected" />

        <TextView
            android:id="@+id/top_pill_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
