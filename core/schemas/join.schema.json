{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigebox.local/schemas/join.schema.json",
  "title": "JOIN",
  "description": "El teléfono pide unirse a un lugar con el token del QR. (juez → central)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "fightId",
    "seat",
    "token",
    "judgeName",
    "deviceId",
    "credentialFingerprint"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "JOIN"
    },
    "fightId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "judgeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "credentialFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
