<?xml version="1.0" encoding="utf-8"?>
<!-- Round tardío obligatorio (DESIGN.md v2 §6.5, v6 «Esquina» spec 007): como Puntuar, sobre arena con el
     anillo de rounds y las filas de esquina; no se puede salir sin enviar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/late_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arena"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <include layout="@layout/view_top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/late_title"
                style="@style/Text.Sigebox.CardTitle"
                android:textColor="@color/on_arena"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/late_status"
                style="@style/Text.Sigebox.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- v5 §5.16: segmentos de rounds, ocultos en la v6 (los usan RoundSegments y sus pruebas). -->
        <LinearLayout
            android:id="@+id/late_progress"
            style="@style/Widget.Sigebox.RoundSegments"
            android:visibility="gone" />

        <!-- v6: anillo de rounds; el actual es el round tardío. -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp">

            <com.sigebox.juez.ui.RoundRing
                android:id="@+id/late_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/late_ring_number"
                android:visibility="gone"
                style="@style/Text.Sigebox.RingNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textSize="40sp" />
        </FrameLayout>

        <TextView
            style="@style/Text.Sigebox.Support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/late_body"
            android:textColor="@color/on_arena_2" />

        <include
            android:id="@+id/late_red_card"
            layout="@layout/view_corner_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <include
            android:id="@+id/late_blue_card"
            layout="@layout/view_corner_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/late_message"
            style="@style/Text.Sigebox.Support"
            android:textColor="@color/on_arena_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/late_send"
            style="@style/Widget.Sigebox.Pill.Arena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/late_send" />
    </LinearLayout>
</ScrollView>
