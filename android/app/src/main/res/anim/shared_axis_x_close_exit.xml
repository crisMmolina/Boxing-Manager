<?xml version="1.0" encoding="utf-8"?>
<!-- Eje compartido X (como MaterialSharedAxis X), al volver, la que se cierra sale hacia la derecha (DESIGN.md v5 §3.7, ≤ 300 ms). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/motion_enter"
    android:interpolator="@anim/motion_curve"
    android:shareInterpolator="true">
    <translate
        android:fromXDelta="0%"
        android:toXDelta="8%" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
