<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens de docs/DESIGN.md v4 §3.1, tema claro. El oscuro está en values-night/colors.xml.
     Contrastes: ContrastV4Test. Ninguna pantalla usa colores fuera de estos. -->
<resources>
    <color name="bg">#FAF9F6</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#F2F0EB</color>
    <color name="line">#E3DFD7</color>
    <color name="ink">#111110</color>
    <color name="ink_2">#57534C</color>
    <!-- Borde de campo: la línea decorativa no llega a 3:1, este sí. -->
    <color name="field_border">#8C877D</color>
    <color name="primary">#111110</color>
    <color name="on_primary">#FFFFFF</color>
    <!-- Dorado: solo foco, paso actual, progreso y selección. -->
    <color name="accent">#7A5A2A</color>
    <color name="accent_soft">#F3E7CF</color>
    <!-- Barra superior negra en los dos temas. -->
    <color name="bar">#111110</color>
    <color name="on_bar">#F7F5F0</color>
    <color name="on_bar_2">#B9B3A8</color>
    <color name="bar_accent">#C9A35E</color>
    <!-- Rojo y azul: solo las esquinas. -->
    <color name="red">#9F2241</color>
    <color name="on_red">#FFFFFF</color>
    <color name="red_numeral">#9F2241</color>
    <color name="blue">#266CB4</color>
    <color name="on_blue">#FFFFFF</color>
    <color name="blue_numeral">#266CB4</color>
    <color name="connected">#027A35</color>
    <color name="disconnected">#57534C</color>
    <color name="skeleton">#E9E6DF</color>
    <!-- v5 (DESIGN.md §3.8): mismos nombres que la central. Contrastes en §3.8. -->
    <color name="success_soft">#E3F3E8</color>
    <color name="success_ink">#027A35</color>
    <color name="pending_ink">#5C431E</color>
    <!-- Texto terciario: solo texto grande o componente en claro (3.47:1). -->
    <color name="ink_3">#8F897E</color>
    <!-- Pista del anillo y segmentos sin usar (decorativo). -->
    <color name="ring_track">#E9E6DF</color>
    <color name="nav">#111110</color>
    <color name="nav_ink">#B9B3A8</color>
    <color name="nav_ink_dim">#8F897E</color>
    <color name="nav_active">#2A2418</color>
    <!-- Los colores exactos de guantes-colgando.svg: solo el logo, nunca la interfaz. -->
    <color name="logo_negro">#000000</color>
    <color name="logo_rojo">#FF1800</color>
    <color name="logo_claro">#FFF7F9</color>
    <!-- Sustituye el borde en reposo de Material: el borde con foco sale de boxStrokeColor (§5.4). -->
    <color name="mtrl_textinput_default_box_stroke_color">@color/field_border</color>
    <!-- v6 «Esquina» (spec 007): superficie arena negra en los dos temas para Puntuar, Round enviado y
         Round tardío. Contrastes: ContrastV6Test. No hay copia en values-night: arena es igual en los dos. -->
    <color name="arena">#0B0B0A</color>
    <color name="arena_2">#1A1917</color>
    <color name="arena_line">#6E685E</color>
    <!-- Contorno de los botones − y + sobre la fila (3:1 o más). -->
    <color name="arena_control">#8F897E</color>
    <color name="on_arena">#F7F5F0</color>
    <color name="on_arena_2">#B9B3A8</color>
    <!-- Número de cada esquina sobre arena: el guinda y el azul de las píldoras no llegan a 4.5 sobre negro. -->
    <color name="arena_red">#F08AA0</color>
    <color name="arena_blue">#8CB8EE</color>
    <!-- Anillo de rounds: cerrados, actual (dorado, el único acento) y pendientes (decorativo). -->
    <color name="ring_done">#4CC27A</color>
    <color name="ring_current">#D4AF5A</color>
    <color name="ring_pending">#2E2B27</color>
    <!-- Palomita de Round enviado sobre arena: círculo verde oscuro y trazo verde claro. -->
    <color name="arena_success">#16301F</color>
    <color name="arena_success_ink">#7FE0A2</color>
</resources>
