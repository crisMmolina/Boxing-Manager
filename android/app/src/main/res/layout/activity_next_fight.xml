<?xml version="1.0" encoding="utf-8"?>
<!-- Entre peleas: espera de la siguiente (con esquinas si ya se conocen) o fin del evento. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <include layout="@layout/view_top_bar_brand" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- v5 (AND-024): estado ilustrado; el reloj cambia a palomita cuando el evento terminó. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/next_fight_badge"
                style="@style/Widget.Sigebox.Badge"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/next_fight_badge_icon"
                    style="@style/Widget.Sigebox.Badge.Icon"
                    android:src="@drawable/ic_clock"
                    android:tag="clock"
                    app:tint="@color/pending_ink" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/next_fight_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                app:indicatorColor="@color/accent" />

            <TextView
                android:id="@+id/next_fight_title"
                style="@style/Text.Sigebox.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/next_fight_title" />

            <TextView
                android:id="@+id/next_fight_corners"
                style="@style/Text.Sigebox.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/next_fight_support"
                style="@style/Text.Sigebox.Support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/next_fight_support" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_fight_back"
        style="@style/Widget.Sigebox.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/next_fight_back_to_join"
        android:visibility="gone" />
</LinearLayout>
